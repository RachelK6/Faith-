# Copy this file to .env and fill in real values. Never commit .env itself.

DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Microsoft SQL Server ---
MSSQL_DB_NAME=optimum_erp_lms
MSSQL_DB_USER=your_sql_user
MSSQL_DB_PASSWORD=your_sql_password
MSSQL_DB_HOST=localhost
MSSQL_DB_PORT=1433
MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# Production: Encrypt=yes;TrustServerCertificate=no;
# Local SQL Server without a trusted certificate: Encrypt=yes;TrustServerCertificate=yes;
MSSQL_EXTRA_PARAMS=Encrypt=yes;TrustServerCertificate=yes;
DB_CONN_MAX_AGE=60

CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Production email delivery (development uses Django's console mailer)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email-service-user
EMAIL_HOST_PASSWORD=your-email-service-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL="Optimum LMS <no-reply@example.com>"

# External code-execution sandbox (see apps/execution/views.py)
SANDBOX_URL=http://localhost:9000
SANDBOX_TOKEN=                          # shared secret with the code runner (see sandbox/README.md)

# --- Added: account links, uploads, code runner, proxies ---
PASSWORD_RESET_TIMEOUT=3600            # seconds a reset link stays valid (1 hour)
EMAIL_VERIFICATION_TIMEOUT=86400       # seconds a verification link stays valid (24 hours)
SUBMISSION_MAX_UPLOAD_MB=10
# Dev: emails print to the runserver console. To capture them in files instead:
# EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
# EMAIL_FILE_PATH=sent_emails
NUM_PROXIES=0                           # set to 1 behind nginx / a load balancer, or the login limit locks everyone out
